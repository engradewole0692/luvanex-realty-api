APP_NAME="Luvanex Realty API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# Local default: SQLite. Production (Forge): MySQL + credentials.
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=luvanex_realty
# DB_USERNAME=
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Frontend CORS (credentialed) — never use "*"
# Comma-separated SPA origins. Production must include https://luvanexrealty.com
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8080
FRONTEND_URLS=http://localhost:8080,http://localhost:8081,https://web.luvanexrealty.com,https://luvanexrealty.com

# -----------------------------------------------------------------------------
# Sessions / cookies (Sanctum SPA)
#
# Cross-origin auth architecture (expected for Forge):
#   Frontend: https://luvanexrealty.com
#   API:      https://<ACTUAL-FORGE-HOSTNAME>   (different host; do NOT invent api.luvanexrealty.com)
#
# Because the API hostname is typically NOT a sibling of luvanexrealty.com,
# SESSION_DOMAIN must remain null (cookie scoped to the API host only).
# Do NOT set SESSION_DOMAIN=.luvanexrealty.com unless the API truly shares that
# registrable domain.
#
# Cross-site cookie requirements for SPA auth:
#   SESSION_SECURE_COOKIE=true
#   SESSION_SAME_SITE=none
#   SESSION_DOMAIN=null
#
# SANCTUM_STATEFUL_DOMAINS lists the SPA host(s) (no scheme), e.g. luvanexrealty.com
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# Hosts that receive stateful Sanctum cookies (no scheme). Include SPA hosts only.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,localhost:8081,127.0.0.1,127.0.0.1:8080,web.luvanexrealty.com,luvanexrealty.com

# -----------------------------------------------------------------------------
# Admin seeder (local defaults only — NEVER use ChangeMeSecurely! in production)
# Production: set a strong unique ADMIN_PASSWORD before:
#   php artisan db:seed --class=AdminUserSeeder
# -----------------------------------------------------------------------------
ADMIN_NAME="Luvanex Administrator"
ADMIN_EMAIL=admin@luvanexrealty.com
ADMIN_PASSWORD=ChangeMeSecurely!

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Mail — organization From; visitor email is Reply-To only (never From)
# SMTP credentials must stay server-side. Do not put these in VITE_* vars.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@luvanexrealty.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO_ADDRESS=enquiries@luvanexrealty.com

# =============================================================================
# PRODUCTION (Laravel Forge) — example values only, no secrets
# =============================================================================
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://<ACTUAL-FORGE-HOSTNAME>
# LOG_CHANNEL=stack
# LOG_LEVEL=error
#
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
#
# FRONTEND_URL=https://luvanexrealty.com
# FRONTEND_URLS=https://luvanexrealty.com
# # Optionally keep https://web.luvanexrealty.com during cutover only
#
# SANCTUM_STATEFUL_DOMAINS=luvanexrealty.com
# SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=none
#
# QUEUE_CONNECTION=database
# CACHE_STORE=database
# FILESYSTEM_DISK=local
#
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@luvanexrealty.com
# MAIL_FROM_NAME="Luvanex Realty"
# MAIL_TO_ADDRESS=enquiries@luvanexrealty.com
#
# ADMIN_EMAIL=
# ADMIN_PASSWORD=   # strong unique value; required for production seeding
#
# Forge queue worker (database queue):
#   php artisan queue:work --sleep=3 --tries=3 --timeout=90
#
# Forge scheduler: not required (no scheduled tasks currently)
#
# After deploy:
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache
#   php artisan route:cache
#   php artisan view:cache
#   php artisan db:seed --class=AdminUserSeeder   # only with secure ADMIN_* set
#
# Health check: GET /up
# API root: GET /  → {"name":"Luvanex Realty API","status":"ok"}
#
# Frontend production env (separate app):
#   VITE_SITE_URL=https://luvanexrealty.com
#   VITE_API_BASE_URL=https://<ACTUAL-FORGE-HOSTNAME>
# Never use the Forge hostname as the public SEO canonical / sitemap origin.
